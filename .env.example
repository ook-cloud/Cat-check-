# Copy this file to .env and fill in the values. See README.md for where to find them.

# Supabase > Connect > ORM > Prisma. Replace [YOUR-PASSWORD] with your database password.
# The app uses DATABASE_URL. The session pooler (port 5432) works for everything.
DATABASE_URL="postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres"

# Optional. If DATABASE_URL is the transaction pooler (port 6543, ?pgbouncer=true),
# set DIRECT_URL to the session pooler (port 5432): migrations use it instead.
# DIRECT_URL="postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres"

# Supabase > Project Settings > API. Keep the secret key private: it is only used on the server.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="your-secret-or-service-role-key"

# The public Storage bucket that holds the photos and the saved model.
SUPABASE_BUCKET="cat-lab"
